rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required) - The unique identifier for the user
    //   - email: string (required) - The user's email address
    //   - displayName: string (optional) - The user's display name
    //   - photoURL: string (optional) - The user's photo URL
    //   - createdAt: timestamp (optional) - When the user was created
    //
    // Collection: entries
    // Document ID: {entryId}
    // Fields:
    //   - id: string (required) - The unique identifier for the entry
    //   - userId: string (required) - The ID of the user who created the entry
    //   - userEmail: string (optional) - The email of the user who created the entry
    //   - userName: string (optional) - The name of the user who created the entry
    //   - date: string (required) - The date of the overtime
    //   - startTime: string (optional) - The start time of the overtime
    //   - endTime: string (optional) - The end time of the overtime
    //   - duration: number (required) - The duration of the overtime in hours
    //   - description: string (optional) - A description of the work performed
    //   - status: string (required, enum: ['pending', 'approved', 'rejected']) - The status of the entry
    //   - createdAt: timestamp (optional) - When the entry was created
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         (request.auth.token.email == "litoncomar95@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.fullName is string;
    }

    function isValidEntry(data) {
      return data.id is string &&
             data.date is string &&
             data.duration is number &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /entries/{entryId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && (isOwner(request.resource.data.userId) || isAdmin()) && isValidEntry(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin()) && isValidEntry(request.resource.data);
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }

    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /connection_requests/{requestId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /history/{historyId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && (isOwner(request.resource.data.userId) || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
